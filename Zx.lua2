-- ZX EXTERNAL — cola no Arceus X ou Delta
-- verde/azul, neve caindo, armas reais, spawn, nick, emote, kill, anti-detect

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local HTTP = game:GetService("HttpService")
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()

-- ── ANTI DETECT ──────────────────────────────────────────────────
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    -- bloqueia FireServer de scripts de detecção
    if method == "FireServer" then
        local name = tostring(args[1])
        if name:find("detect") or name:find("cheat") or name:find("hack") then
            return nil
        end
    end
    return old(self, ...)
end)
setreadonly(mt, true)

-- ── GUI ──────────────────────────────────────────────────────────
local sg = Instance.new("ScreenGui", game.CoreGui)
sg.Name = "ZXExternal"
sg.ResetOnSpawn = false
sg.IgnoreGuiInset = true

-- NEVE CAINDO
for i = 1, 60 do
    local floco = Instance.new("TextLabel", sg)
    floco.Text = "❄"
    floco.TextColor3 = Color3.fromRGB(180, 230, 255)
    floco.BackgroundTransparency = 1
    floco.TextSize = math.random(10, 22)
    floco.ZIndex = 1
    local startX = math.random(0, 100) / 100
    floco.Position = UDim2.new(startX, 0, -0.05, 0)
    floco.Size = UDim2.new(0, 30, 0, 30)

    local speed = math.random(2, 6)
    local drift = (math.random(-10, 10)) / 1000

    RS.Heartbeat:Connect(function(dt)
        floco.Position = UDim2.new(
            floco.Position.X.Scale + drift,
            0,
            floco.Position.Y.Scale + dt / speed,
            0
        )
        if floco.Position.Y.Scale > 1.05 then
            floco.Position = UDim2.new(math.random(0,100)/100, 0, -0.05, 0)
        end
    end)
end

