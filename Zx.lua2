scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 4
scroll.ScrollBarImageColor3 = Color3.fromRGB(0, 200, 120)
scroll.ZIndex = 11
scroll.CanvasSize = UDim2.new(0, 0, 0, 900)

